FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///instox.db
PORT=5000

# LLM — any OpenAI-compatible endpoint. Set provider=openai_compat to enable.
# "stub" runs local canned answers with no network calls (default).
LLM_PROVIDER=stub

# Point LLM_BASE_URL / LLM_MODEL / LLM_API_KEY at your provider of choice:
#   DeepSeek: base=https://api.deepseek.com/v1 model=deepseek-chat
#   Qwen:     base=https://dashscope-intl.aliyuncs.com/compatible-mode/v1 model=qwen-plus
#   Zhipu:    base=https://open.bigmodel.cn/api/paas/v4 model=glm-4
#   OpenAI:   base=https://api.openai.com/v1 model=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Vision model for "snap items → cart". Falls back to LLM_* if unset.
# Suggested: qwen-vl-plus (DashScope), glm-4v (Zhipu), gpt-4o-mini (OpenAI)
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=qwen-vl-plus
